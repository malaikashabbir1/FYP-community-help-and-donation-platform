<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donate to <%= campaign.name %></title>

  <link rel="stylesheet" href="/css/output.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

<!-- NAVBAR -->
<header class="bg-blue-600 text-white shadow">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <h1 class="font-bold text-emerald-300 text-sm sm:text-lg">
      Donor Panel
    </h1>

    <a href="/donor/dashboard" class="text-xs sm:text-sm hover:underline">
      Back to Dashboard
    </a>
  </div>
</header>

<!-- MAIN -->
<main class="flex-grow px-4 py-10 flex justify-center">

  <div class="w-full max-w-3xl">

    <div class="bg-white rounded-xl shadow-md overflow-hidden">

      <!-- HEADER -->
      <div class="bg-blue-600 text-white p-5">
        <h2 class="text-lg sm:text-2xl font-bold">
          Donate to Campaign
        </h2>
        <p class="text-sm text-blue-100 mt-1">
          Your contribution makes a difference
        </p>
      </div>

      <div class="p-5 space-y-6">

        <!-- CAMPAIGN INFO -->
        <div class="bg-gray-50 border rounded-lg p-4">

          <h3 class="text-lg font-semibold text-gray-800">
            <%= campaign.name %>
          </h3>

          <p class="text-sm text-gray-600 mt-1">
            <%= campaign.description || "No description available" %>
          </p>

          <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">

            <div class="bg-blue-50 border border-blue-200 px-4 py-3 rounded-lg">
              <p class="text-blue-600 font-medium">Goal</p>
              <p class="text-blue-900 font-bold text-base">Rs <%= campaign.goal %></p>
            </div>

            <div class="bg-green-50 border border-green-200 px-4 py-3 rounded-lg">
              <p class="text-green-600 font-medium">Raised</p>
              <p class="text-green-900 font-bold text-base">Rs <%= campaign.raised %></p>
            </div>

            <div class="bg-red-50 border border-red-200 px-4 py-3 rounded-lg">
              <p class="text-red-600 font-medium">Remaining</p>
              <p class="text-red-900 font-bold text-base">Rs <%= campaign.remaining %></p>
            </div>

          </div>

        </div>

        <!-- FORM -->
        <form action="/donor/donate" method="POST" class="space-y-4">

          <input type="hidden" name="campaignId" value="<%= campaign._id %>">

          <!-- QUICK AMOUNT -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Quick Amount
            </label>

            <div class="flex gap-2">
              <button type="button" onclick="setAmount(100, this)"
                class="amount-btn flex-1 border rounded-lg py-2 text-sm hover:bg-gray-100 transition">
                100
              </button>

              <button type="button" onclick="setAmount(500, this)"
                class="amount-btn flex-1 border rounded-lg py-2 text-sm hover:bg-gray-100 transition">
                500
              </button>

              <button type="button" onclick="setAmount(1000, this)"
                class="amount-btn flex-1 border rounded-lg py-2 text-sm hover:bg-gray-100 transition">
                1000
              </button>
            </div>
          </div>

          <!-- AMOUNT -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Donation Amount
            </label>

            <div class="flex items-center border rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-blue-400">
              <span class="bg-gray-100 px-3 py-2 text-sm border-r">Rs</span>

              <input id="amountInput"
                     type="number"
                     name="amount"
                     min="1"
                     placeholder="Enter amount"
                     class="w-full px-3 py-2 text-sm outline-none">
            </div>

            <p id="amountError" class="text-red-600 text-sm mt-2 hidden"></p>
          </div>

          <!-- BUTTON -->
          <button type="button"
                  onclick="openModal()"
                  <%= campaign.remaining === 0 ? 'disabled' : '' %>
                  class="w-full py-3 rounded-lg text-sm font-semibold transition
                  <%= campaign.remaining === 0
                    ? 'bg-gray-400 cursor-not-allowed'
                    : 'bg-green-600 hover:bg-green-700 text-white' %>">

            <%= campaign.remaining === 0 ? 'Fully Funded' : 'Donate Now' %>

          </button>

        </form>

      </div>
    </div>

  </div>

</main>

<!-- MODAL -->
<div id="donationModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-50 px-4">

  <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-6 text-center">

    <!-- ICON -->
    <div class="flex justify-center mb-4">
      <div class="h-14 w-14 rounded-full bg-green-100 flex items-center justify-center">
        <i class="fa-solid fa-hand-holding-dollar text-green-600 text-xl"></i>
      </div>
    </div>

    <!-- TITLE -->
    <h2 class="text-xl font-bold text-gray-800 mb-2">
      Confirm Donation
    </h2>

    <!-- TEXT -->
    <p class="text-sm text-gray-600 mb-6 leading-relaxed">
      Are you sure you want to proceed with this donation?
    </p>

    <!-- BUTTONS -->
    <div class="flex gap-4">

      <button type="button"
        onclick="closeModal()"
        class="flex-1 py-3 rounded-lg bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold transition">

        Cancel

      </button>

      <button type="button"
        onclick="submitDonation()"
        class="flex-1 py-3 rounded-lg bg-green-600 hover:bg-green-700 text-white font-semibold transition">

        Confirm

      </button>

    </div>

  </div>

</div>

<!-- FOOTER -->
<%- include('../partials/footer') %>

<!-- SCRIPT -->
<script>

  const remaining = Number("<%= campaign.remaining || 0 %>");

  function setAmount(value, btn) {

    document.getElementById("amountInput").value = value;

    document.querySelectorAll(".amount-btn").forEach(b => {
      b.classList.remove("bg-blue-600", "text-white");
    });

    btn.classList.add("bg-blue-600", "text-white");

    hideError();
  }

  document.getElementById("amountInput").addEventListener("input", function () {
    document.querySelectorAll(".amount-btn").forEach(b => {
      b.classList.remove("bg-blue-600", "text-white");
    });

    hideError();
  });

  function openModal() {

    const amount = Number(document.getElementById("amountInput").value);

    if (!amount) return showError("Please enter amount");

    if (amount < 50) return showError("Minimum donation is 50");

    if (amount > remaining) return showError("Maximum allowed is Rs " + remaining);

    document.getElementById("donationModal").classList.remove("hidden");
    document.getElementById("donationModal").classList.add("flex");
  }

  function closeModal() {
    document.getElementById("donationModal").classList.add("hidden");
    document.getElementById("donationModal").classList.remove("flex");
  }

  function submitDonation() {
    document.querySelector("form").submit();
  }

  function showError(msg) {
    const err = document.getElementById("amountError");
    err.textContent = msg;
    err.classList.remove("hidden");
  }

  function hideError() {
    const err = document.getElementById("amountError");
    err.textContent = "";
    err.classList.add("hidden");
  }

</script>

</body>
</html>