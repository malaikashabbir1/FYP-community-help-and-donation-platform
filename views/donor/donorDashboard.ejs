<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Donor Dashboard</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="bg-slate-100 min-h-screen pt-16">

  <%- include('../partials/navbar') %>

  <!-- MAIN -->
   <main class="px-6 py-10">

    <!-- HEADER -->
    <div class="max-w-7xl mx-auto pt-10 px-4 text-center">

      <h1 class="text-3xl font-bold text-slate-800 tracking-tight">
        Donor Dashboard
      </h1>

      <p class="text-slate-500 mt-2 text-lg">
        Welcome,
        <span class="font-semibold text-slate-700">
          <%= user.name %>
        </span>
      </p>

    </div>

    <!-- FLASH MESSAGE -->
    <div class="max-w-7xl mx-auto px-4 mt-6">

      <% if (message) { %>

        <div id="alertBox"
          class="px-4 py-4 rounded-xl shadow-sm flex justify-between items-center
          <%= message.type === 'success'
              ? 'bg-green-100 text-green-700 border border-green-300'
              : 'bg-red-100 text-red-700 border border-red-300' %>">

          <span class="text-sm font-semibold">
            <%= message.text %>
          </span>

          <button
            onclick="document.getElementById('alertBox').remove()"
            class="text-lg font-bold px-2">
            &times;
          </button>

        </div>

      <% } %>

    </div>

    <!-- QUICK ACTIONS -->
    <div class="max-w-7xl mx-auto mt-10 grid grid-cols-1 md:grid-cols-3 gap-6 px-4">

      <!-- LIVE CAMPAIGNS -->
      <a href="/campaigns/live"
        class="bg-blue-600 hover:bg-blue-700 text-white p-6 rounded-2xl text-center font-semibold hover:scale-[1.02] hover:shadow-xl transition duration-300">

        <i class="fas fa-fire text-3xl mb-4"></i>

        <div class="text-lg">
          Live Campaigns
        </div>

      </a>

      <!-- MY DONATIONS -->
      <a href="/donor/my-donations"
        class="bg-purple-600 hover:bg-purple-700 text-white p-6 rounded-2xl text-center font-semibold hover:scale-[1.02] hover:shadow-xl transition duration-300">

        <i class="fas fa-wallet text-3xl mb-4"></i>

        <div class="text-lg">
          My Donations
        </div>

      </a>

      <!-- SUCCESS STORIES -->
      <a href="/<%= user.role %>/campaigns/completed"
        class="bg-green-600 hover:bg-green-700 text-white p-6 rounded-2xl text-center font-semibold hover:scale-[1.02] hover:shadow-xl transition duration-300">

        <i class="fas fa-trophy text-3xl mb-4"></i>

        <div class="text-lg">
          Success Stories
        </div>

      </a>

    </div>

    <!-- DONATION OVERVIEW -->
    <div class="max-w-7xl mx-auto mt-12 px-4">

      <div class="bg-slate-50/90 backdrop-blur rounded-2xl shadow-md border border-slate-200 p-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">

          <h2 class="text-2xl font-bold text-slate-800">
            Donation Overview
          </h2>

          <div class="bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-semibold w-fit">
            Your Activity
          </div>

        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- TOTAL DONATIONS -->
          <div class="bg-blue-100/70 border-l-4 border-blue-600 rounded-2xl p-6 flex items-center justify-between shadow-sm hover:shadow-md transition">

            <div>

              <p class="text-sm text-slate-600 mb-1">
                Total Donations
              </p>

              <p class="text-3xl font-bold text-blue-700">
                <%= stats.totalDonations %>
              </p>

            </div>

            <div class="bg-blue-200 p-4 rounded-full">
              <i class="fas fa-hand-holding-heart text-2xl text-blue-700"></i>
            </div>

          </div>

          <!-- TOTAL AMOUNT -->
          <div class="bg-green-100/70 border-l-4 border-green-600 rounded-2xl p-6 flex items-center justify-between shadow-sm hover:shadow-md transition">

            <div>

              <p class="text-sm text-slate-600 mb-1">
                Total Amount
              </p>

              <p class="text-3xl font-bold text-green-700">
                Rs <%= stats.totalAmount %>
              </p>

            </div>

            <div class="bg-green-200 p-4 rounded-full">
              <i class="fas fa-coins text-2xl text-green-700"></i>
            </div>

          </div>

          <!-- ACTIVE CAMPAIGNS -->
          <div class="bg-indigo-100/70 border-l-4 border-indigo-600 rounded-2xl p-6 flex items-center justify-between shadow-sm hover:shadow-md transition">

            <div>

              <p class="text-sm text-slate-600 mb-1">
                Active Campaigns
              </p>

              <p class="text-3xl font-bold text-indigo-700">
                <%= stats.activeCampaigns %>
              </p>

            </div>

            <div class="bg-indigo-200 p-4 rounded-full">
              <i class="fas fa-bolt text-2xl text-indigo-700"></i>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- RECENT DONATIONS -->
    <div class="max-w-7xl mx-auto mt-12 px-4">

      <div class="bg-slate-50/90 backdrop-blur rounded-2xl shadow-md border border-slate-200 p-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">

          <h2 class="text-2xl font-bold text-slate-800">
            Recent Donations
          </h2>

          <a href="/donor/my-donations"
            class="text-sm font-semibold text-blue-600 hover:text-blue-700 transition">
            View All
          </a>

        </div>

        <div class="space-y-4">

          <% if (recentDonations && recentDonations.length > 0) { %>

            <% recentDonations.forEach(donation => { %>

              <div class="bg-white border border-slate-200 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:shadow-md transition duration-300">

                <!-- LEFT -->
                <div class="flex items-start gap-4">

                  <div class="bg-purple-100 text-purple-700 p-4 rounded-full flex items-center justify-center min-w-[56px] min-h-[56px]">
                    <i class="fas fa-heart"></i>
                  </div>

                  <div>

                    <h3 class="font-bold text-slate-800 text-lg break-words">
                      <%= donation.campaign?.name || 'Campaign' %>
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">
                      <%= donation.campaign?.category %> • <%= donation.campaign?.subCategory %>
                    </p>

                    <p class="text-sm text-slate-500 mt-1">
                      Donated on
                      <%= new Date(donation.createdAt).toLocaleDateString() %>
                    </p>

                  </div>

                </div>

                <!-- RIGHT -->
                <div class="text-left sm:text-right">

                  <p class="text-2xl font-semibold text-green-600">
                    Rs <%= donation.amount %>
                  </p>

                  <span class="inline-block mt-2 bg-green-100 text-green-700 text-xs px-3 py-1 rounded-full font-semibold">
                    Successful
                  </span>

                </div>

              </div>

            <% }) %>

          <% } else { %>

            <!-- EMPTY STATE -->
            <div class="bg-white border-2 border-dashed border-slate-300 rounded-2xl p-10 text-center">

              <div class="bg-slate-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-5">

                <i class="fas fa-hand-holding-heart text-3xl text-slate-400"></i>

              </div>

              <h3 class="text-xl font-bold text-slate-700">
                No Donations Yet
              </h3>

              <p class="text-slate-500 mt-2 max-w-md mx-auto">
                Start supporting meaningful campaigns and make a positive impact today.
              </p>

              <a href="/campaigns/live"
                class="inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-xl transition duration-300 shadow-md hover:shadow-lg">

                Explore Campaigns

              </a>

            </div>

          <% } %>

        </div>

      </div>

    </div>

  </main>

  <%- include('../partials/footer') %>

  <!-- FLASH AUTO FADE -->
  <script>
    setTimeout(() => {
      const alertBox = document.getElementById('alertBox');

      if (alertBox) {
        alertBox.style.transition = "opacity 0.5s ease";
        alertBox.style.opacity = "0";

        setTimeout(() => {
          alertBox.remove();
        }, 500);
      }
    }, 3000);
  </script>

</body>
</html>