<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fraud Alerts</title>

  <link rel="icon" type="image/png" href="/images/logo.PNG">
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="flex flex-col min-h-screen bg-slate-100 font-[Inter]">

<%- include('../partials/navbar') %>

<main class="flex-grow px-4 sm:px-6 lg:px-8 py-6 sm:py-10">

  <!-- HEADER -->
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:justify-between lg:items-center gap-4 mb-6 sm:mb-8">

    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Fraud Alerts</h1>
      <p class="text-sm sm:text-base text-slate-600 mt-1">
        Monitor suspicious activity across the system
      </p>
    </div>

    <form action="/admin/fraud/batch-scan" method="POST" class="w-full lg:w-auto">
      <button type="submit"
        class="w-full lg:w-auto bg-red-600 hover:bg-red-700 text-white px-5 sm:px-6 py-3 rounded-xl shadow-lg transition flex items-center justify-center gap-3 text-sm sm:text-base font-semibold">

        <i class="fas fa-shield-halved"></i>
        Run Fraud Scan
      </button>
    </form>

  </div>

  <!-- CONTENT -->
  <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-md p-4 sm:p-6 border border-slate-200">

    <!-- MESSAGE -->
    <% if (query && query.msg) { %>
      <div class="mb-4 p-3 rounded-lg text-sm sm:text-base
        <%= query.status === 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">

        <%= query.msg %>
      </div>
    <% } %>

    <!-- ALERT LIST -->
    <% if (fraudAlerts && fraudAlerts.length > 0) { %>

      <div class="space-y-4">

        <% fraudAlerts.forEach(alert => { %>

          <div class="fraud-card p-4 sm:p-5 rounded-xl border flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3 sm:gap-4 hover:shadow-md transition
            <%= alert.source === 'realtime'
                ? 'bg-red-50 border-red-200'
                : 'bg-blue-50 border-blue-200 opacity-95' %>">

            <!-- LEFT -->
            <div class="flex gap-3 sm:gap-4 w-full">

              <!-- ICON -->
              <div class="w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center rounded-full text-white flex-shrink-0
                <%= alert.source === 'realtime' ? 'bg-red-600' : 'bg-blue-600' %>">

                <i class="fas fa-shield-halved text-sm sm:text-base"></i>
              </div>

              <div class="w-full">

                <!-- TITLE + BADGES -->
                <div class="flex flex-wrap items-center gap-2">

                  <p class="font-semibold text-slate-800 text-sm sm:text-base">
                    <%= alert.type || "Fraud Alert" %>
                  </p>

                  <% if (alert.source === 'realtime') { %>
                    <span class="text-xs px-2 py-1 rounded-full bg-red-200 text-red-800 font-semibold">
                      REAL-TIME
                    </span>
                  <% } else { %>
                    <span class="text-xs px-2 py-1 rounded-full bg-blue-200 text-blue-800 font-semibold">
                      BATCH SCAN
                    </span>
                  <% } %>

                  <span class="text-xs px-2 py-1 rounded-full bg-slate-200 text-slate-700">
                    FLAGGED
                  </span>

                </div>

                <!-- USER INFO -->
                <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                  <span class="font-semibold">User:</span>
                  <%= alert.user?.name || "System" %>

                  <% if (alert.campaign) { %>
                    <span class="mx-1 sm:mx-2">•</span>
                    <span class="font-semibold">Campaign:</span>
                    <%= alert.campaign?.name %>
                  <% } %>
                </p>

                <!-- REASON -->
                <p class="text-xs sm:text-sm text-slate-700 mt-2 leading-relaxed">
                  <span class="font-semibold">Reason:</span>
                  <%= alert.message || "No details provided" %>
                </p>

              </div>
            </div>

            <!-- TIME -->
            <div class="fraud-time text-xs text-slate-400 sm:text-right whitespace-nowrap pl-12 sm:pl-0">
              <%= alert.createdAt ? new Date(alert.createdAt).toLocaleString() : "N/A" %>
            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <!-- EMPTY STATE -->
      <div class="text-center py-10 sm:py-12 text-slate-500">

        <i class="fas fa-shield-halved text-3xl sm:text-4xl mb-3 text-slate-300"></i>

        <p class="text-base sm:text-lg font-semibold">No Fraud Alerts Found</p>
        <p class="text-xs sm:text-sm mt-1">System is currently clean</p>

      </div>

    <% } %>

  </div>

</main>

<%- include('../partials/footer') %>

<!-- MOBILE LAYOUT FIX SCRIPT -->
<script>
  function adjustFraudLayout() {
    const isMobile = window.innerWidth < 640;

    document.querySelectorAll(".fraud-card").forEach(card => {
      const time = card.querySelector(".fraud-time");
      if (!time) return;

      if (isMobile) {
        time.classList.add("mt-2", "pl-12");
      } else {
        time.classList.remove("mt-2", "pl-12");
      }
    });
  }

  window.addEventListener("load", adjustFraudLayout);
  window.addEventListener("resize", adjustFraudLayout);
</script>

</body>
</html>