<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campaigns</title>

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

<%- include('../../partials/navbar') %>

<main class="flex-grow">

<div class="max-w-7xl mx-auto py-6 sm:py-10 px-3 sm:px-4">

  <!-- HEADER -->
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6 sm:mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold">Campaigns</h1>
  </div>

  <!-- FLASH MESSAGE -->
  <% if (message) { %>
    <div id="alertBox"
      class="mb-6 px-4 py-3 rounded-lg shadow-sm flex justify-between items-center
      <%= message.type === 'success'
          ? 'bg-green-100 text-green-700 border border-green-300'
          : 'bg-red-100 text-red-700 border border-red-300' %>">

      <span class="text-sm font-medium"><%= message.text %></span>

      <button onclick="document.getElementById('alertBox').remove()"
        class="text-lg font-bold px-2">&times;</button>
    </div>
  <% } %>

  <!-- SEARCH + FILTER -->
  <form method="GET" action="/admin/campaigns" class="mb-6 flex flex-col sm:flex-row gap-3">

    <input 
      type="text"
      name="search"
      placeholder="Search campaign..."
      class="w-full sm:w-1/2 px-3 py-2 border rounded-lg"
      value="<%= search || '' %>"
    />

    <select name="status" class="w-full sm:w-1/4 px-3 py-2 border rounded-lg">
      <option value="">All Status</option>
      <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      <option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Completed</option>
    </select>

    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg">
      Apply
    </button>

  </form>

  <!-- GRID -->
  <% if (campaigns.length === 0) { %>

    <div class="text-center py-20">
      <h2 class="text-xl font-semibold text-gray-600">No campaigns found</h2>
      <p class="text-gray-500 mt-2">Try adjusting your search or filter</p>
    </div>

  <% } else { %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">

      <% campaigns.forEach(c => { %>

        <div class="bg-white rounded-xl shadow hover:shadow-xl transition flex flex-col overflow-hidden">

          <!-- IMAGE -->
          <% if (c.image) { %>
            <img src="<%= c.image %>" class="h-40 sm:h-48 w-full object-cover">
          <% } else { %>
            <div class="h-40 sm:h-48 bg-gray-200 flex items-center justify-center text-gray-500 text-sm">
              No Image
            </div>
          <% } %>

          <!-- BODY -->
          <div class="p-4 sm:p-5 flex flex-col flex-1">

            <h2 class="text-lg sm:text-xl font-semibold line-clamp-2">
              <%= c.name %>
            </h2>

            <p class="text-gray-500 text-xs mt-1">
              By <%= c.createdBy?.name || 'Unknown' %>
            </p>

            <p class="text-gray-600 text-sm mt-2 line-clamp-2">
              <%= c.description %>
            </p>

            <div class="mt-3 text-xs text-gray-600 space-y-1">
              <p><i class="fas fa-bullseye text-blue-500"></i> Goal: <%= c.goal %></p>
              <p><i class="fas fa-hand-holding-dollar text-green-500"></i> Raised: <%= c.raised %></p>
              <p><i class="fas fa-users text-purple-500"></i> Volunteers: <%= (c.volunteers?.length || 0) %> / <%= c.requiredVolunteers %></p>
            </div>

            <div class="flex-1"></div>

            <!-- STATUS -->
            <div class="mt-3">
              <% if (c.status === 'pending') { %>
                <span class="bg-orange-100 text-orange-700 px-2 py-1 text-xs rounded">Pending</span>
              <% } else if (c.status === 'active') { %>
                <span class="bg-green-100 text-green-700 px-2 py-1 text-xs rounded">Live</span>
              <% } else if (c.status === 'rejected') { %>
                <span class="bg-red-100 text-red-700 px-2 py-1 text-xs rounded">Rejected</span>
              <% } else { %>
                <span class="bg-blue-100 text-blue-700 px-2 py-1 text-xs rounded">Completed</span>
              <% } %>
            </div>

            <!-- ACTIONS -->
            <div class="mt-4 space-y-2">

              <a href="/campaigns/<%= c._id %>"
                 class="w-full block text-center bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 rounded-lg text-sm font-medium">
                Details
              </a>

              <% if (c.status === 'pending') { %>
                <a href="/admin/campaigns/<%= c._id %>/review"
                  class="w-full block text-center bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg text-sm font-medium">
                  Review
                </a>
              <% } %>

              <% if (c.status === 'active') { %>
                <form action="/admin/campaigns/<%= c._id %>/complete" method="POST">

                  <button type="button"
                    onclick="openModal(this.form, 'Complete Campaign', 'Are you sure you want to mark this campaign as COMPLETED?')"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-sm font-medium">
                    Complete
                  </button>

                </form>
              <% } %>

              <% if (c.status === 'rejected' || c.status === 'completed') { %>
                <form action="/admin/campaigns/<%= c._id %>/delete" method="POST">

                  <button type="button"
                    onclick="openModal(this.form, 'Delete Campaign', 'This will permanently DELETE the campaign. Continue?')"
                    class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg text-sm font-medium">
                    Delete
                  </button>

                </form>
              <% } %>

            </div>

          </div>
        </div>

      <% }) %>

    </div>

  <% } %>

</div>

</main>

<!-- 🔥 MODAL (UPDATED ONLY) -->
<div id="confirmModal"
  class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 px-4">

  <div id="modalCard"
    class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-6 text-center
    transform scale-95 opacity-0 transition duration-200">

    <!-- ICON -->
    <div class="flex justify-center mb-4">
      <div id="modalIconBox"
        class="h-14 w-14 rounded-full bg-blue-100 flex items-center justify-center">

        <i id="modalIcon" class="fa-solid fa-circle-info text-blue-600 text-xl"></i>

      </div>
    </div>

    <!-- TITLE -->
    <h2 id="modalTitle" class="text-xl font-bold text-gray-800"></h2>

    <!-- MESSAGE -->
    <p id="modalMessage" class="text-sm text-gray-600 mt-2"></p>

    <!-- BUTTONS -->
    <div class="flex justify-center gap-4 mt-6">

      <button onclick="closeModal()"
        class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold transition">
        Cancel
      </button>

      <button id="confirmBtn"
        class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition">
        Confirm
      </button>

    </div>

  </div>
</div>

<!-- 🔥 SCRIPT (UPDATED MODAL LOGIC ONLY) -->
<script>
  let activeForm = null;

  function openModal(form, title, message) {
    activeForm = form;

    document.getElementById('modalTitle').innerText = title;
    document.getElementById('modalMessage').innerText = message;

    // ICON LOGIC
    const icon = document.getElementById('modalIcon');
    const box = document.getElementById('modalIconBox');

    box.className = "h-14 w-14 rounded-full flex items-center justify-center";

    if (title.toLowerCase().includes("delete")) {
      icon.className = "fa-solid fa-trash text-red-600 text-xl";
      box.classList.add("bg-red-100");
    } 
    else if (title.toLowerCase().includes("complete")) {
      icon.className = "fa-solid fa-circle-check text-green-600 text-xl";
      box.classList.add("bg-green-100");
    } 
    else {
      icon.className = "fa-solid fa-circle-info text-blue-600 text-xl";
      box.classList.add("bg-blue-100");
    }

    const modal = document.getElementById('confirmModal');
    const card = document.getElementById('modalCard');

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    setTimeout(() => {
      card.classList.remove('scale-95', 'opacity-0');
      card.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeModal() {
    const modal = document.getElementById('confirmModal');
    const card = document.getElementById('modalCard');

    card.classList.add('scale-95', 'opacity-0');
    card.classList.remove('scale-100', 'opacity-100');

    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 200);

    activeForm = null;
  }

  document.getElementById('confirmBtn').addEventListener('click', function () {
    if (activeForm) activeForm.submit();
  });

  // FLASH AUTO HIDE
  setTimeout(() => {
    const alertBox = document.getElementById('alertBox');
    if (alertBox) {
      alertBox.style.transition = "opacity 0.5s ease";
      alertBox.style.opacity = "0";
      setTimeout(() => alertBox.remove(), 500);
    }
  }, 3000);
</script>

<%- include('../../partials/footer') %>

</body>
</html>