<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- INTER FONT -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="flex flex-col min-h-screen bg-slate-100 font-[Inter]">

<%- include('../partials/navbar') %>

<main class="flex-grow px-6 py-10">

<!-- HEADER -->
<div class="max-w-7xl mx-auto text-center mb-10">
  <h1 class="text-3xl font-bold text-slate-900">
    Admin Dashboard
  </h1>

  <p class="text-slate-600 mt-1">
    Welcome, <span class="font-semibold text-slate-800"><%= user?.name || "Admin" %></span>
  </p>
</div>

<!-- USER OVERVIEW -->
<div class="max-w-7xl mx-auto mb-10 bg-slate-50/80 backdrop-blur rounded-2xl shadow-md p-6 border border-slate-200">

  <h2 class="text-xl font-bold text-slate-900 mb-5">User Overview</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

    <div class="bg-blue-100/70 border-l-4 border-blue-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Total Users</p>
        <p class="text-2xl font-bold text-blue-700"><%= totalUsers || 0 %></p>
      </div>
      <i class="fas fa-users text-2xl text-blue-600"></i>
    </div>

    <div class="bg-green-100/70 border-l-4 border-green-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Donors</p>
        <p class="text-2xl font-bold text-green-700"><%= donors || 0 %></p>
      </div>
      <i class="fas fa-hand-holding-heart text-2xl text-green-600"></i>
    </div>

    <div class="bg-purple-100/70 border-l-4 border-purple-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Volunteers</p>
        <p class="text-2xl font-bold text-purple-700"><%= volunteers || 0 %></p>
      </div>
      <i class="fas fa-user-friends text-2xl text-purple-600"></i>
    </div>

  </div>
</div> 

<!-- CAMPAIGN OVERVIEW -->
<div class="max-w-7xl mx-auto mb-10 bg-slate-50/80 backdrop-blur rounded-2xl shadow-md p-6 border border-slate-200">

  <h2 class="text-xl font-bold text-slate-900 mb-5">Campaign Overview</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">

    <div class="bg-slate-200/70 border-l-4 border-slate-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Total Campaigns</p>
        <p class="text-2xl font-bold text-slate-800"><%= totalCampaigns || 0 %></p>
      </div>
      <i class="fas fa-bullhorn text-2xl text-slate-600"></i>
    </div>

    <div class="bg-amber-100/70 border-l-4 border-amber-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Pending</p>
        <p class="text-2xl font-bold text-amber-700"><%= pendingCampaigns || 0 %></p>
      </div>
      <i class="fas fa-pencil-alt text-2xl text-amber-600"></i>
    </div>

    <div class="bg-blue-100/70 border-l-4 border-blue-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Active</p>
        <p class="text-2xl font-bold text-blue-700"><%= activeCampaigns || 0 %></p>
      </div>
      <i class="fas fa-bolt text-2xl text-blue-600"></i>
    </div>

    <div class="bg-emerald-100/70 border-l-4 border-emerald-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Completed</p>
        <p class="text-2xl font-bold text-emerald-700"><%= completedCampaigns || 0 %></p>
      </div>
      <i class="fas fa-check-circle text-2xl text-emerald-600"></i>
    </div>

    <div class="bg-red-100/70 border-l-4 border-red-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Rejected</p>
        <p class="text-2xl font-bold text-red-700"><%= rejectedCampaigns || 0 %></p>
      </div>
      <i class="fas fa-times-circle text-2xl text-red-600"></i>
    </div>

  </div>
</div>

<!-- QUICK ACTIONS -->
<div class="max-w-7xl mx-auto bg-slate-50 rounded-2xl shadow-md p-8 mb-10 border border-slate-200">

  <h2 class="text-lg font-bold text-slate-800 mb-6">Quick Actions</h2>

  <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-6 gap-6">

    <a href="/admin/users"
       class="bg-blue-600 hover:bg-blue-700 text-white rounded-xl p-6 text-center shadow-md">
      <i class="fas fa-users text-2xl"></i>
      <p class="mt-2 font-semibold">Manage Users</p>
    </a>

    <a href="/admin/donations"
       class="bg-green-600 hover:bg-green-700 text-white rounded-xl p-6 text-center shadow-md">
      <i class="fas fa-hand-holding-heart text-2xl"></i>
      <p class="mt-2 font-semibold">Donations</p>
    </a>

    <!-- ✅ VOLUNTEER APPLICATIONS (WITH COUNTER) -->
    <a href="/admin/applications"
       class="bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl p-6 text-center shadow-md relative">

      <i class="fas fa-user-check text-2xl"></i>
      <p class="mt-2 font-semibold">Volunteer Applications</p>

      <% if (pendingApplications > 0) { %>
        <span class="absolute top-2 right-2 bg-white text-indigo-600 px-2 py-0.5 rounded-full text-xs font-bold">
          <%= pendingApplications %>
        </span>
      <% } %>

    </a>

    <a href="/admin/campaigns?status=pending"
      class="bg-purple-600 hover:bg-purple-700 text-white rounded-xl p-6 text-center shadow-md relative">

      <i class="fas fa-clock text-2xl"></i>
      <p class="mt-2 font-semibold">Pending Approvals</p>

      <% if (pendingCampaigns > 0) { %>
        <span class="absolute top-2 right-2 bg-white text-purple-600 px-2 py-0.5 rounded-full text-xs font-bold">
          <%= pendingCampaigns %>
        </span>
      <% } %>

    </a>

    <a href="/admin/fraud-alerts"
      class="bg-red-600 hover:bg-red-700 text-white rounded-xl p-6 text-center shadow-md">

      <i class="fas fa-shield-alt text-2xl"></i>
      <p class="mt-2 font-semibold">Fraud Alerts</p>

    </a>

    <a href="/admin/campaigns"
       class="bg-yellow-500 hover:bg-yellow-600 text-white rounded-xl p-6 text-center shadow-md">
      <i class="fas fa-bullhorn text-2xl"></i>
      <p class="mt-2 font-semibold">Campaigns</p>
    </a>

  </div>
</div>

<!-- RECENT ACTIVITY -->
<div class="max-w-7xl mx-auto mt-10 bg-white rounded-2xl shadow-md p-4 sm:p-6 border border-slate-200">

  <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
    <i class="fas fa-stream text-indigo-600"></i>
    Recent Activity Logs
  </h2>

  <% if (recentActivity && recentActivity.length > 0) { %>

    <div class="space-y-4">

      <% recentActivity.forEach(log => { 

        const rawType = (log.type || '').toString().toLowerCase().trim();
        let type = rawType;

        if (["user", "donor", "volunteer", "registration"].includes(type)) {
          type = "registration";
        }

        let icon = "fas fa-bell";
        let bg = "bg-slate-500";
        let badge = "bg-slate-100 text-slate-700";

        if (type === "donation") {
          icon = "fas fa-hand-holding-heart";
          bg = "bg-green-500";
          badge = "bg-green-100 text-green-700";
        } 
        else if (type === "application") {
          icon = "fas fa-user-check";
          bg = "bg-blue-500";
          badge = "bg-blue-100 text-blue-700";
        } 
        else if (type === "registration") {
          icon = "fas fa-user-circle";
          bg = "bg-purple-600";
          badge = "bg-purple-100 text-purple-700";
        } 
        else if (type === "campaign") {
          icon = "fas fa-bullhorn";
          bg = "bg-yellow-500";
          badge = "bg-yellow-100 text-yellow-700";
        }
      %>

      <!-- CARD -->
      <div class="bg-slate-50 hover:bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 transition-all duration-300 hover:shadow-md">

        <div class="flex flex-col sm:flex-row sm:justify-between gap-4">

          <!-- LEFT SIDE -->
          <div class="flex items-start gap-4 min-w-0 flex-1">

            <!-- ICON -->
            <div class="w-12 h-12 sm:w-14 sm:h-14 flex-shrink-0 flex items-center justify-center rounded-full text-white <%= bg %>">
              <i class="<%= icon %>"></i>
            </div>

            <!-- TEXT -->
            <div class="min-w-0 flex-1">

              <p class="font-medium text-slate-800 break-words leading-relaxed">
                <%= log.description %>
              </p>

              <div class="flex flex-wrap items-center gap-2 mt-3">

                <span class="text-xs text-slate-500">
                  <span class="font-semibold">User:</span>
                  <%= log.userId?.name || "System" %>
                </span>

                <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= badge %>">
                  <%= type %>
                </span>

              </div>

            </div>

          </div>

          <!-- RIGHT SIDE (DATE) -->
          <div class="text-xs text-slate-400 sm:text-right flex-shrink-0">
            <%= new Date(log.createdAt).toLocaleString() %>
          </div>

        </div>

      </div>

      <% }) %>

    </div>

  <% } else { %>

    <div class="text-center py-10 text-slate-500">
      <i class="fa-regular fa-folder-open text-4xl mb-3"></i>
      <p>No activity logs found</p>
    </div>

  <% } %>

</div>

</main>

<%- include('../partials/footer') %>

<!-- FLOATING BUTTON -->
<div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">

  <a href="/admin/donations/summary"
     class="bg-indigo-600 text-white px-6 py-4 rounded-full shadow-lg flex items-center gap-2 hover:bg-indigo-700 transition cta-pulse">

    <i class="fas fa-chart-pie"></i>
    <span class="hidden sm:inline font-semibold">Donation Analytics</span>

  </a>

</div>

<style>
@keyframes softPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
  50% { transform: scale(1.05); box-shadow: 0 0 15px 5px rgba(34, 197, 94, 0.2); }
}
.cta-pulse { animation: softPulse 2.5s infinite; }
</style>

</body>
</html>