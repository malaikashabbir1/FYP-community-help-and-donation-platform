<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Donation Details</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-slate-100 min-h-screen">

<%- include('../../partials/navbar') %>

<div class="flex items-center justify-center py-10 px-4">

  <div class="w-full max-w-2xl">

    <!-- HEADER -->
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-slate-800">Donation Details</h1>
      <p class="text-sm text-slate-500">Complete information about this donation</p>
    </div>

    <!-- CARD -->
    <div class="bg-white rounded-xl shadow-md p-6 space-y-5">

      <!-- DONOR -->
      <div class="flex justify-between">
        <span class="text-sm text-slate-500">Donor</span>
        <span class="font-semibold text-slate-800">
          <%= donation.donor?.name %>
        </span>
      </div>

      <!-- CAMPAIGN -->
      <div class="flex justify-between">
        <span class="text-sm text-slate-500">Campaign</span>
        <span class="font-semibold text-slate-800">
          <%= donation.campaign?.name %>
        </span>
      </div>

      <!-- AMOUNT -->
      <div class="flex justify-between">
        <span class="text-sm text-slate-500">Amount</span>
        <span class="font-bold text-green-600">
          Rs <%= donation.amount %>
        </span>
      </div>

      <!-- DATE -->
      <div class="flex justify-between">
        <span class="text-sm text-slate-500">Date</span>
        <span class="text-slate-700">
          <%= new Date(donation.createdAt).toDateString() %>
        </span>
      </div>

      <!-- PROGRESS -->
      <div class="border-t pt-4 space-y-2">

        <p class="text-sm text-slate-500">Campaign Progress</p>

        <div class="flex justify-between text-sm text-slate-700">
          <span>Goal</span>
          <span>Rs <%= donation.campaign?.goal %></span>
        </div>

        <div class="flex justify-between text-sm text-slate-700">
          <span>Raised</span>
          <span>Rs <%= donation.campaign?.raised %></span>
        </div>

        <%
          let goal = donation.campaign?.goal || 0;
          let raised = donation.campaign?.raised || 0;
          let percent = goal > 0 ? (raised / goal) * 100 : 0;
          percent = Math.min(percent, 100);
        %>

        <div class="mt-3">
          <div class="w-full bg-slate-200 rounded-full h-2">
            <div class="bg-green-500 h-2 rounded-full" style="width:<%= percent %>%"></div>
          </div>

          <p class="text-right text-xs text-green-600 mt-1">
            <%= percent.toFixed(1) %>% funded
          </p>
        </div>

      </div>

    </div>

    <!-- BACK BUTTON -->
    <div class="mt-6 text-center">
      <a href="/admin/donations"
         class="text-blue-600 hover:underline font-medium">
        ← Back to Donations
      </a>
    </div>

  </div>

</div>

<%- include('../../partials/footer') %>

</body>
</html>