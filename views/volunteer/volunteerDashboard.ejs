<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Volunteer Dashboard</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-slate-100 min-h-screen pt-16">

<%- include('../partials/navbar') %>

<main class="px-6 py-10">

<!-- HEADER -->
<div class="max-w-7xl mx-auto mt-8 text-center px-4">
  <h1 class="text-3xl font-bold text-gray-800">Volunteer Dashboard</h1>
  <p class="text-gray-600 mt-1">
    Welcome, <span class="font-semibold"><%= user.name || 'Volunteer' %></span>
  </p>
</div>

<!-- QUICK ACTIONS -->
<div class="max-w-7xl mx-auto mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 px-4">

  <a href="/volunteer/campaigns/create"
     class="bg-blue-600 text-white p-5 rounded-xl text-center font-semibold hover:bg-blue-700 shadow-md transition">
    <i class="fas fa-plus mb-2"></i>
    <div>Create Campaign</div>
  </a>

  <a href="/volunteer/campaigns/my"
     class="bg-purple-600 text-white p-5 rounded-xl text-center font-semibold hover:bg-purple-700 shadow-md transition">
    <i class="fas fa-folder-open mb-2"></i>
    <div>My Campaigns</div>
  </a>

  <a href="/volunteer/applications"
     class="bg-indigo-600 text-white p-5 rounded-xl text-center font-semibold hover:bg-indigo-700 shadow-md transition">
    <i class="fas fa-file-alt mb-2"></i>
    <div>My Applications</div>
  </a>

  <a href="/campaigns/live"
     class="bg-green-600 text-white p-5 rounded-xl text-center font-semibold hover:bg-green-700 shadow-md transition">
    <i class="fas fa-bolt mb-2"></i>
    <div>Explore Campaigns</div>
  </a>

</div>

<!-- MY CAMPAIGN OVERVIEW -->
<div class="max-w-7xl mx-auto mt-10 mb-10 bg-slate-50/80 backdrop-blur rounded-2xl shadow-md p-6 border border-slate-200">

  <h2 class="text-xl font-bold text-slate-900 mb-5">My Campaign Overview</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 xl:grid-cols-6 gap-5">

    <div class="bg-blue-100/70 border-l-4 border-blue-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Total Campaigns</p>
        <p class="counter text-2xl font-bold text-blue-700"
           data-value="<%= stats?.myStats?.totalCampaigns || 0 %>">0</p>
      </div>
      <i class="fas fa-layer-group text-2xl text-blue-600"></i>
    </div>

    <div class="bg-emerald-100/70 border-l-4 border-emerald-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Approved Applications</p>
        <p class="counter text-2xl font-bold text-emerald-700"
           data-value="<%= stats?.myStats?.joinedCampaigns || 0 %>">0</p>
      </div>
      <i class="fas fa-handshake text-2xl text-emerald-600"></i>
    </div>

    <div class="bg-yellow-100/70 border-l-4 border-yellow-500 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Drafts</p>
        <p class="counter text-2xl font-bold text-yellow-700"
           data-value="<%= stats?.myStats?.drafts || 0 %>">0</p>
      </div>
      <i class="fas fa-pen text-2xl text-yellow-600"></i>
    </div>

    <div class="bg-indigo-100/70 border-l-4 border-indigo-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Pending</p>
        <p class="counter text-2xl font-bold text-indigo-700"
           data-value="<%= stats?.myStats?.pending || 0 %>">0</p>
      </div>
      <i class="fas fa-clock text-2xl text-indigo-600"></i>
    </div>

    <div class="bg-green-100/70 border-l-4 border-green-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Active</p>
        <p class="counter text-2xl font-bold text-green-700"
           data-value="<%= stats?.myStats?.active || 0 %>">0</p>
      </div>
      <i class="fas fa-bolt text-2xl text-green-600"></i>
    </div>

    <div class="bg-blue-100/70 border-l-4 border-blue-600 rounded-xl p-6 flex justify-between">
      <div>
        <p class="text-sm text-slate-600">Completed</p>
        <p class="counter text-2xl font-bold text-blue-700"
           data-value="<%= stats?.myStats?.completed || 0 %>">0</p>
      </div>
      <i class="fas fa-check-circle text-2xl text-blue-600"></i>
    </div>

  </div>
</div>

<!-- ===================== RECENT JOINED CAMPAIGNS (NEW SECTION) ===================== -->
<div class="max-w-7xl mx-auto mb-10 bg-white rounded-2xl shadow-md p-6 border border-slate-200">

  <div class="flex justify-between items-center mb-5">
    <h2 class="text-xl font-bold text-gray-800">Recent Joined Campaigns</h2>

    <a href="/volunteer/applications?status=approved"
       class="text-sm text-blue-600 hover:underline font-semibold">
      View All
    </a>
  </div>

  <div class="space-y-4">

    <% if (recentJoinedCampaigns && recentJoinedCampaigns.length > 0) { %>

      <% recentJoinedCampaigns.forEach(app => { %>

        <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl border">

          <div>
            <h3 class="font-semibold text-gray-800">
              <%= app.campaign?.name || 'Campaign' %>
            </h3>

            <p class="text-xs text-gray-500 mt-1">
              <%= app.campaign?.category %> • Joined on <%= new Date(app.createdAt).toLocaleDateString() %>
            </p>
          </div>

          <span class="bg-green-100 text-green-700 text-xs px-3 py-1 rounded-full font-semibold">
            Approved
          </span>

        </div>

      <% }) %>

    <% } else { %>

      <p class="text-gray-500 text-sm">No recent joined campaigns yet.</p>

    <% } %>

  </div>
</div>

<!-- CTA -->
<a href="/campaigns/live"
   class="fixed bottom-6 right-6 bg-green-600 text-white px-10 py-5 rounded-full shadow-lg flex items-center gap-2 z-50 hover:bg-green-700 transition">
  <i class="fas fa-bolt"></i>
  <span class="hidden sm:inline font-semibold">Explore Campaigns</span>
</a>

</main>

<%- include('../partials/footer') %>

<!-- COUNTER SCRIPT -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const counters = document.querySelectorAll(".counter");

  counters.forEach(counter => {
    const target = parseInt(counter.getAttribute("data-value")) || 0;
    let current = 0;

    const duration = 700;
    const step = Math.max(1, Math.floor(target / (duration / 20)));

    const update = () => {
      current += step;

      if (current < target) {
        counter.innerText = current;
        setTimeout(update, 20);
      } else {
        counter.innerText = target;
      }
    };

    update();
  });
});
</script>

</body>
</html>