<!DOCTYPE html>
<html>
<head>
  <title>My Campaigns</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

<%- include('../../partials/navbar') %>

<main class="flex-grow">

<div class="max-w-7xl mx-auto py-6 sm:py-10 px-3 sm:px-4">

  <!-- HEADER -->
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6 sm:mb-8">

    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">My Campaigns</h1>
      <p class="text-sm text-gray-500">Manage and track your campaigns</p>
    </div>

    <a href="/volunteer/campaigns/create"
      class="w-full sm:w-auto text-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
      + Create Campaign
    </a>

  </div>

  <!-- FLASH -->
  <% if (message) { %>

    <div id="alertBox"
      class="mb-6 px-4 py-3 rounded-lg shadow flex justify-between items-center
      <%= message.type === 'success'
        ? 'bg-green-100 text-green-700 border border-green-300'
        : 'bg-red-100 text-red-700 border border-red-300' %>">

      <span class="text-sm font-medium"><%= message.text %></span>

      <button onclick="document.getElementById('alertBox').remove()"
        class="text-lg font-bold px-2">&times;</button>

    </div>

  <% } %>

  <!-- EMPTY -->
  <% if (campaigns.length === 0) { %>

    <div class="text-center py-20">
      <h2 class="text-xl font-semibold text-gray-600">No campaigns yet</h2>
      <p class="text-gray-500 mt-2">Create your first campaign to get started</p>
    </div>

  <% } else { %>

  <!-- GRID -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <% campaigns.forEach(c => { %>

      <div class="bg-white rounded-xl shadow hover:shadow-xl transition flex flex-col overflow-hidden">

        <!-- IMAGE -->
        <% if (c.image) { %>
          <img src="<%= c.image %>" class="h-40 sm:h-48 w-full object-cover">
        <% } else { %>
          <div class="h-40 sm:h-48 bg-gray-200 flex items-center justify-center text-gray-500">
            No Image
          </div>
        <% } %>

        <!-- CONTENT -->
        <div class="p-4 sm:p-5 flex flex-col flex-1">

          <h2 class="text-lg font-semibold line-clamp-2 text-gray-800">
            <%= c.name %>
          </h2>

          <p class="text-sm text-gray-600 mt-1 line-clamp-3">
            <%= c.description %>
          </p>

        <!-- META -->
<div class="mt-3 text-xs text-gray-500 space-y-1">

  <% if (c.location) { %>
    <p>
      <i class="fa-solid fa-location-dot mr-1"></i>
      <%= c.location %>
    </p>
  <% } %>

  <!-- CATEGORY (NEW) -->
  <% if (c.category) { %>
    <p>
      <i class="fa-solid fa-tag mr-1"></i>

      <%= c.category
        .replaceAll('_',' ')
        .replace(/\b\w/g, l => l.toUpperCase()) %>

    </p>
  <% } %>

  <!-- URGENCY -->
  <p>
    <i class="fa-solid fa-bolt mr-1"></i>

    <%= c.urgency.charAt(0).toUpperCase() +
        c.urgency.slice(1) %> Priority

  </p>

  <p>
    <i class="fa-solid fa-users mr-1"></i>
    <%= approvedCountMap[c._id.toString()] || 0 %> /
    <%= c.requiredVolunteers || 0 %>
  </p>

  <p>
    <i class="fa-solid fa-calendar mr-1"></i>
    <%= new Date(c.createdAt).toLocaleDateString() %>
  </p>

</div>

          <!-- STATUS -->
          <div class="mt-3">
            <% if (c.status === 'draft') { %>
              <span class="bg-yellow-100 text-yellow-700 px-2 py-1 text-xs rounded">Draft</span>
            <% } else if (c.status === 'pending') { %>
              <span class="bg-orange-100 text-orange-700 px-2 py-1 text-xs rounded">Pending</span>
            <% } else if (c.status === 'active') { %>
              <span class="bg-green-100 text-green-700 px-2 py-1 text-xs rounded">Active</span>
            <% } else if (c.status === 'rejected') { %>
              <span class="bg-red-100 text-red-700 px-2 py-1 text-xs rounded">Rejected</span>
            <% } else { %>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 text-xs rounded">Completed</span>
            <% } %>
          </div>

          <!-- PROGRESS -->
          <%
            let progress = c.goal > 0 ? Math.min((c.raised / c.goal) * 100, 100) : 0;
          %>

          <div class="mt-3">
            <div class="flex justify-between text-xs mb-1">
              <span>Rs. <%= c.raised %></span>
              <span>Rs. <%= c.goal %></span>
            </div>

            <div class="w-full bg-gray-200 h-2 rounded-full">
              <div class="bg-green-500 h-2 rounded-full"
                style="width:<%= progress + '%' %>"></div>
            </div>
          </div>

          <!-- ACTIONS -->
          <div class="mt-4 flex gap-2">

            <% if (c.status === 'draft') { %>

              <a href="/volunteer/campaigns/edit/<%= c._id %>"
                class="flex-1 text-center bg-gray-200 hover:bg-gray-300 py-2 rounded text-sm">
                Edit
              </a>

              <form id="submitForm-<%= c._id %>"
                method="POST"
                action="/volunteer/campaigns/<%= c._id %>/submit"
                class="flex-1">

                <button type="button"
                  onclick="openModal('submitForm-<%= c._id %>', 'Submit Campaign', 'Are you sure you want to submit this campaign for review?')"
                  class="w-full bg-green-600 hover:bg-green-700 text-white py-2 rounded text-sm">

                  Submit

                </button>

              </form>

            <% } else if (c.status === 'rejected') { %>

              <a href="/volunteer/campaigns/edit/<%= c._id %>?resubmit=true"
                class="w-full text-center bg-yellow-500 hover:bg-yellow-600 text-white py-2 rounded text-sm">
                Fix & Resubmit
              </a>

            <% } else if (c.status === 'pending') { %>

              <div class="w-full text-center text-xs text-orange-600 py-2">
                Waiting for review...
              </div>

            <% } else { %>

              <div class="w-full text-center text-xs text-gray-500 py-2">
                No actions
              </div>

            <% } %>

          </div>

        </div>
      </div>

    <% }) %>

  </div>

  <% } %>

</div>

</main>

<%- include('../../partials/footer') %>

<!-- MODAL -->
<div id="confirmModal"
  class="fixed inset-0 hidden items-center justify-center bg-black/50 z-50 px-4">

  <div id="modalCard"
    class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-6 text-center scale-95 opacity-0 transition">

    <div class="flex justify-center mb-3">
      <div class="h-14 w-14 rounded-full bg-blue-100 flex items-center justify-center">
        <i class="fa-solid fa-circle-info text-blue-600 text-xl"></i>
      </div>
    </div>

    <h2 id="modalTitle" class="text-xl font-bold mb-2 text-gray-800"></h2>

    <p id="modalMessage" class="text-sm text-gray-600 mb-6"></p>

    <div class="flex gap-4">

      <button onclick="closeModal()"
        class="flex-1 bg-gray-200 hover:bg-gray-300 py-3 rounded-lg font-semibold">

        Cancel

      </button>

      <button id="confirmBtn"
        class="flex-1 bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-semibold">

        Confirm

      </button>

    </div>

  </div>

</div>

<!-- SCRIPT -->
<script>

  let currentForm = null;

  function openModal(formId, title, message) {

    currentForm = formId;

    document.getElementById("modalTitle").innerText = title;
    document.getElementById("modalMessage").innerText = message;

    const modal = document.getElementById("confirmModal");
    const card = document.getElementById("modalCard");

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    setTimeout(() => {
      card.classList.remove("scale-95", "opacity-0");
      card.classList.add("scale-100", "opacity-100");
    }, 10);

  }

  function closeModal() {

    const modal = document.getElementById("confirmModal");
    const card = document.getElementById("modalCard");

    card.classList.add("scale-95", "opacity-0");
    card.classList.remove("scale-100", "opacity-100");

    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }, 200);

    currentForm = null;
  }

  document.getElementById("confirmBtn").addEventListener("click", () => {
    if (currentForm) {
      document.getElementById(currentForm).submit();
    }
  });

  
  // Flash Message FADE OUT 
  setTimeout(() => {
      const alertBox = document.getElementById('alertBox');
      if (alertBox) {
        alertBox.style.transition = "opacity 0.5s ease";
        alertBox.style.opacity = "0";
        setTimeout(() => alertBox.remove(), 500);
      }
    }, 3000);

</script>

</body>
</html>