<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Campaign</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

<%- include('../../partials/navbar') %>

<main class="flex-grow">

<div class="max-w-xl mx-auto px-4 py-8">

  <h1 class="text-xl sm:text-3xl font-bold mb-6">
    Create Campaign
  </h1>

  <div class="bg-white p-4 sm:p-6 rounded-xl shadow">

    <!-- FLASH MESSAGE -->
    <% if (message && message.type === 'error') { %>
      <p class="text-red-600 text-sm mb-4 font-medium">
        <%= message.text %>
      </p>
    <% } %>

    <% if (message && message.type === 'success') { %>
      <p class="text-green-600 text-sm mb-4 font-medium">
        <%= message.text %>
      </p>
    <% } %>

    <!-- FORM -->
    <form action="/volunteer/campaigns/create"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4">

      <!-- NAME -->
      <input type="text" name="name" placeholder="Campaign Name" class="w-full border p-3 rounded   text-sm sm:text-base" required 
      pattern="[A-Za-z\s]+" title="Only letters are allowed (no numbers or symbols)"
      oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">

      <!-- DESCRIPTION -->
      <textarea name="description" placeholder="Description"
      class="w-full border p-3 rounded text-sm sm:text-base"
      required pattern="[A-Za-z\s.,'-]+"
      title="Only letters and basic punctuation allowed"
      oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')"></textarea>

      <!-- GOAL -->
      <input type="number" name="goal" min="100" max="10000000"
        placeholder="Goal Amount"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required>

      <!-- REQUIRED VOLUNTEERS -->
      <input type="number" name="requiredVolunteers"
        min="1"
        placeholder="Required Volunteers"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required>

      <!-- LOCATION -->
      <input type="text" name="location"
        placeholder="Location (e.g. Karachi)"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required pattern="[A-Za-z\s]+" title="Only letters are allowed in location"
        oninput="this.value = this.value.replace(/[^A-Za-z\s]/g, '')">

      <!-- ================= AI LAYER (ADDED) ================= -->

      <!-- CATEGORY -->
      <select name="category"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required>

        <option value="">Select Category</option>
        <option value="healthcare">Healthcare</option>
        <option value="education">Education</option>
        <option value="emergency">Emergency</option>
        <option value="social">Social</option>
        <option value="animal_welfare">Animal Welfare</option>
        <option value="charity">Charity</option>

      </select>

      <!-- SUB CATEGORY -->
      <select name="subCategory"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required>

        <option value="">Select Sub Category</option>

        <!-- Healthcare -->
        <option value="cancer_treatment">Cancer Treatment</option>
        <option value="surgery">Surgery</option>
        <option value="emergency_care">Emergency Care</option>
        <option value="chronic_illness">Chronic Illness</option>
        <option value="medical_equipment">Medical Equipment</option>

        <!-- Education -->
        <option value="scholarship">Scholarship</option>
        <option value="school_funding">School Funding</option>
        <option value="skill_training">Skill Training</option>

        <!-- Emergency -->
        <option value="flood_relief">Flood Relief</option>
        <option value="earthquake_relief">Earthquake Relief</option>
        <option value="fire_relief">Fire Relief</option>

        <!-- Social -->
        <option value="poverty_relief">Poverty Relief</option>
        <option value="orphan_support">Orphan Support</option>
        <option value="elderly_care">Elderly Care</option>
        <option value="clean_water_project">Clean Water Project</option>
        <option value="clothing_distribution">Clothing Distribution</option>
        <option value="basic_needs_support">Basic Needs Support</option>
        <option value="tree_plantation">Tree Plantation</option>
        <option value="community_development">Community Development</option>

        <!-- Animal -->
        <option value="animal_rescue">Animal Rescue</option>

        <option value="other">Other</option>

      </select>

      <!-- ================= END AI LAYER ================= -->

      <!-- URGENCY -->
      <select name="urgency"
        class="w-full border p-3 rounded text-sm sm:text-base"
        required>

        <option value="low">Low Priority</option>
        <option value="medium" selected>Medium Priority</option>
        <option value="high">High Priority</option>
        <option value="emergency">Emergency</option>

      </select>

      <!-- IMAGE -->
      <input type="file" name="image"
        class="w-full border p-3 rounded text-sm sm:text-base"
        accept="image/*">

      <!-- SUBMIT -->
      <button type="submit"
        class="w-full bg-green-600 text-white py-3 rounded-lg">
        Create Campaign
      </button>

    </form>

  </div>

</div>

</main>

<%- include('../../partials/footer') %>

</body>
</html>