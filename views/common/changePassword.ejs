<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password</title>

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-slate-100 min-h-screen flex flex-col font-[Inter]">

<!-- HEADER -->
<header class="bg-blue-600 text-white shadow">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">

    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.PNG" class="w-10 h-10 rounded-full border-2 border-white object-cover">
      <span class="font-bold text-emerald-300">HelpingHands</span>
    </a>

    <a href="/profile" class="text-sm hover:underline">
      <i class="fas fa-arrow-left mr-1"></i> Back to Profile
    </a>

  </div>
</header>

<!-- MAIN -->
<main class="flex-grow flex items-center justify-center px-4 py-10">

  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">

    <!-- HEADER -->
    <div class="bg-blue-600 text-white text-center p-8">
      <div class="w-20 h-20 mx-auto bg-white rounded-full flex items-center justify-center">
        <i class="fas fa-key text-blue-600 text-2xl"></i>
      </div>

      <h2 class="mt-4 text-xl font-bold">Change Password</h2>
      <p class="text-sm text-blue-100">Secure your account</p>
    </div>

    <!-- FORM -->
    <form action="/profile/change-password" method="POST" class="p-6 space-y-5">

      <!-- SERVER MESSAGE -->
      <% if (message) { %>
        <p class="text-sm text-center font-semibold 
          <%= message.type === 'success' ? 'text-green-600' : 'text-red-600' %>">
          <%= message.text %>
        </p>
      <% } %>

      <!-- OLD PASSWORD -->
      <div>
        <label class="text-sm text-slate-600">Old Password</label>

        <div class="mt-1 flex items-center gap-3 border rounded-xl px-3 py-2">
          <i class="fas fa-lock text-slate-400"></i>

          <input id="oldPassword" type="password" name="oldPassword"
            class="w-full outline-none bg-transparent"
            placeholder="Enter old password">

          <i class="fas fa-eye text-slate-400 cursor-pointer"
             onclick="togglePassword('oldPassword', this)"></i>
        </div>

        <p class="text-xs text-red-600 mt-1 hidden" id="oldError"></p>
      </div>

      <!-- NEW PASSWORD -->
      <div>
        <label class="text-sm text-slate-600">New Password</label>

        <div class="mt-1 flex items-center gap-3 border rounded-xl px-3 py-2">
          <i class="fas fa-key text-slate-400"></i>

          <input id="newPassword" type="password" name="newPassword"
            class="w-full outline-none bg-transparent"
            placeholder="Enter new password">

          <i class="fas fa-eye text-slate-400 cursor-pointer"
             onclick="togglePassword('newPassword', this)"></i>
        </div>

        <p class="text-xs text-red-600 mt-1 hidden" id="newError"></p>
      </div>

      <!-- CONFIRM PASSWORD -->
      <div>
        <label class="text-sm text-slate-600">Confirm Password</label>

        <div class="mt-1 flex items-center gap-3 border rounded-xl px-3 py-2">
          <i class="fas fa-check text-slate-400"></i>

          <input id="confirmPassword" type="password" name="confirmPassword"
            class="w-full outline-none bg-transparent"
            placeholder="Confirm password">

          <i class="fas fa-eye text-slate-400 cursor-pointer"
             onclick="togglePassword('confirmPassword', this)"></i>
        </div>

        <p class="text-xs text-red-600 mt-1 hidden" id="confirmError"></p>
      </div>

      <!-- BUTTON -->
      <button type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold">

        <i class="fas fa-shield-alt mr-2"></i>
        Update Password
      </button>

    </form>

  </div>

</main>

<!-- SCRIPT -->
<script>
  const oldPassword = document.getElementById("oldPassword");
  const newPassword = document.getElementById("newPassword");
  const confirmPassword = document.getElementById("confirmPassword");

  const oldError = document.getElementById("oldError");
  const newError = document.getElementById("newError");
  const confirmError = document.getElementById("confirmError");

  function show(el, msg) {
    el.innerText = msg;
    el.classList.remove("hidden");
  }

  function hide(el) {
    el.innerText = "";
    el.classList.add("hidden");
  }

  function togglePassword(id, icon) {
    const input = document.getElementById(id);

    if (input.type === "password") {
      input.type = "text";
      icon.classList.replace("fa-eye", "fa-eye-slash");
    } else {
      input.type = "password";
      icon.classList.replace("fa-eye-slash", "fa-eye");
    }
  }

  // LIVE VALIDATION
  oldPassword.addEventListener("input", () => {
    oldPassword.value.trim() ? hide(oldError) : show(oldError, "Old password required");
  });

  newPassword.addEventListener("input", () => {
    if (newPassword.value.length > 0 && newPassword.value.length < 6) {
      show(newError, "Minimum 6 characters required");
    } else {
      hide(newError);
    }
  });

  confirmPassword.addEventListener("input", () => {
    if (confirmPassword.value !== newPassword.value) {
      show(confirmError, "Passwords do not match");
    } else {
      hide(confirmError);
    }
  });

  // SUBMIT VALIDATION
  document.querySelector("form").addEventListener("submit", (e) => {
    let valid = true;

    if (!oldPassword.value.trim()) {
      show(oldError, "Old password is required");
      valid = false;
    }

    if (!newPassword.value.trim()) {
      show(newError, "New password is required");
      valid = false;
    }

    if (!confirmPassword.value.trim()) {
      show(confirmError, "Confirm password is required");
      valid = false;
    }

    if (newPassword.value !== confirmPassword.value) {
      show(confirmError, "Passwords do not match");
      valid = false;
    }

    if (!valid) e.preventDefault();
  });

</script>

</body>
</html>