<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="bg-slate-100 min-h-screen flex flex-col font-[Inter]">

<!-- HEADER -->
<header class="bg-blue-600 text-white shadow">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">

    <a href="/" class="flex items-center space-x-3">
      <img src="/images/logo.PNG" class="w-10 h-10 rounded-full object-contain border-2 border-white" />
      <span class="font-bold text-emerald-300 text-lg">HelpingHands</span>
    </a>

    <a href="<%= dashboardUrl || '/' %>" class="text-sm hover:underline">
      <i class="fas fa-arrow-left mr-1"></i> Back to Dashboard
    </a>

  </div>
</header>

<!-- MAIN -->
<main class="flex-grow flex items-center justify-center px-4 py-10">

  <div class="w-full max-w-3xl">

    <!-- ✅ FLASH MESSAGE (FIXED) -->
    <% if (message) { %>
      <div id="alertBox"
        class="mb-6 px-4 py-4 rounded-xl shadow-sm flex justify-between items-center
        <%= message.type === 'success'
            ? 'bg-green-100 text-green-700 border border-green-300'
            : 'bg-red-100 text-red-700 border border-red-300' %>">

        <span class="text-sm font-semibold">
          <%= message.text %>
        </span>

        <button
          onclick="document.getElementById('alertBox').remove()"
          class="text-lg font-bold px-2">
          &times;
        </button>

      </div>
    <% } %>

    <!-- PROFILE CARD -->
    <div class="bg-white rounded-3xl shadow-lg border border-slate-200 overflow-hidden">

      <!-- HEADER -->
      <div class="bg-blue-600 text-white p-6 flex items-center gap-4">

        <div class="w-24 h-24 rounded-full bg-blue-50 flex items-center justify-center shadow-inner border border-blue-200">
          <i class="fas fa-user text-blue-700 text-3xl"></i>
        </div>

        <div>
          <h2 class="text-lg font-bold">
            <%= user.name || 'User' %>
          </h2>

          <p class="text-sm text-white/80 capitalize">
            <i class="fas fa-user-tag mr-1"></i>
            <%= user.role || 'User' %>
          </p>
        </div>

      </div>

      <!-- DETAILS -->
      <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">

        <div class="bg-slate-50 border rounded-2xl p-4 flex gap-3">
          <i class="fas fa-envelope text-blue-600 mt-1"></i>
          <div>
            <p class="text-xs text-slate-500">Email</p>
            <p class="font-semibold text-slate-800 text-sm break-all">
              <%= user.email || 'N/A' %>
            </p>
          </div>
        </div>

        <div class="bg-slate-50 border rounded-2xl p-4 flex gap-3">
          <i class="fas fa-id-badge text-purple-600 mt-1"></i>
          <div>
            <p class="text-xs text-slate-500">Role</p>
            <p class="font-semibold capitalize text-slate-800 text-sm">
              <%= user.role || 'User' %>
            </p>
          </div>
        </div>

        <div class="bg-slate-50 border rounded-2xl p-4 flex gap-3">
          <i class="fas fa-circle-check text-green-600 mt-1"></i>
          <div>
            <p class="text-xs text-slate-500">Status</p>
            <p class="font-semibold text-green-600 text-sm">Active</p>
          </div>
        </div>

        <div class="bg-slate-50 border rounded-2xl p-4 flex gap-3">
          <i class="fas fa-fingerprint text-slate-600 mt-1"></i>
          <div>
            <p class="text-xs text-slate-500">User ID</p>
            <p class="font-semibold text-slate-800 text-xs break-all">
              <%= user._id || 'N/A' %>
            </p>
          </div>
        </div>

      </div>

      <!-- ACTIONS -->
      <div class="p-6 flex flex-col sm:flex-row gap-4">

        <a href="/profile/edit"
           class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 text-center py-2 rounded-xl font-semibold text-sm transition">
          <i class="fas fa-pen mr-2"></i>
          Edit Profile
        </a>

        <a href="/profile/change-password"
          class="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-center py-2 rounded-xl font-semibold">
          Change Password
        </a>

      </div>

    </div>

  </div>

</main>

<!-- FOOTER -->
<footer class="mt-auto">
  <%- include('../partials/footer') %>
</footer>

<!-- AUTO FADE -->
<script>
  setTimeout(() => {
    const alertBox = document.getElementById('alertBox');
    if (alertBox) {
      alertBox.style.opacity = "0";
      alertBox.style.transition = "0.5s";
      setTimeout(() => alertBox.remove(), 500);
    }
  }, 3000);
</script>

</body>
</html>