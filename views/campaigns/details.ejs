<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campaign Details</title>

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen">

<%- include('../partials/navbar') %>

<main class="max-w-4xl mx-auto px-4 py-10 space-y-8">

<%
  const donationProgress = Math.min((campaign.raised / campaign.goal) * 100, 100);
  const joined = campaign.volunteers?.length || 0;
  const required = campaign.requiredVolunteers || 0;
  const volunteerProgress = required ? (joined / required) * 100 : 0;
  const remaining = Math.max(0, campaign.goal - campaign.raised);
%>

<!-- HEADER -->
<div class="bg-white rounded-xl shadow p-6 space-y-6">

  <div class="flex gap-5 items-start">

    <!-- IMAGE -->
    <div class="w-24 h-24 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
      <% if (campaign.image) { %>
        <img src="<%= campaign.image %>" class="w-full h-full object-cover">
      <% } %>
    </div>

    <!-- INFO -->
    <div class="flex-1 space-y-3">

      <h1 class="text-2xl font-bold text-gray-800">
        <%= campaign.name %>
      </h1>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-solid fa-user text-gray-500"></i>
        <%= campaign.createdBy?.name %>
      </p>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-solid fa-location-dot text-gray-500"></i>
        <%= campaign.location || 'Not specified' %>
      </p>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-regular fa-calendar text-gray-500"></i>
        Created: <%= new Date(campaign.createdAt).toDateString() %>
      </p>

    </div>

  </div>

</div>

<!-- DESCRIPTION -->
<div class="bg-white rounded-xl shadow p-6 space-y-4">

  <h2 class="text-sm font-semibold text-gray-500 flex items-center gap-2">
    <i class="fa-solid fa-align-left"></i>
    Description
  </h2>

  <p class="text-gray-700 text-sm leading-relaxed">
    <%= campaign.description %>
  </p>

</div>

<!-- STATS -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

  <div class="bg-white p-5 rounded-xl shadow space-y-3">
    <p class="text-gray-500 text-sm flex items-center gap-2">
      <i class="fa-solid fa-bullseye"></i> Goal
    </p>
    <p class="font-bold text-lg">Rs <%= campaign.goal %></p>
  </div>

  <div class="bg-white p-5 rounded-xl shadow space-y-3">
    <p class="text-gray-500 text-sm flex items-center gap-2">
      <i class="fa-solid fa-sack-dollar"></i> Raised
    </p>
    <p class="font-bold text-lg">Rs <%= campaign.raised %></p>
  </div>

  <div class="bg-white p-5 rounded-xl shadow space-y-3">
    <p class="text-gray-500 text-sm flex items-center gap-2">
      <i class="fa-solid fa-wallet"></i> Remaining
    </p>
    <p class="font-bold text-lg">Rs <%= remaining %></p>
  </div>

</div>

<!-- DONATION PROGRESS -->
<div class="bg-white p-6 rounded-xl shadow space-y-4">

  <div class="flex justify-between text-sm text-gray-600">
    <span class="flex items-center gap-2">
      <i class="fa-solid fa-chart-line text-green-600"></i>
      Donation Progress
    </span>

    <span class="font-medium text-gray-700">
      <%= Math.floor(donationProgress) %>%
    </span>
  </div>

  <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
    <div class="bg-green-500 h-3 rounded-full transition-all duration-700"
         style="width: <%= donationProgress %>%"></div>
  </div>

</div>

<!-- VOLUNTEER PROGRESS -->
<div class="bg-white p-6 rounded-xl shadow space-y-4">

  <div class="flex justify-between text-sm text-gray-600">
    <span class="flex items-center gap-2">
      <i class="fa-solid fa-users text-blue-600"></i>
      Volunteer Progress
    </span>

    <span class="font-medium text-gray-700">
      <%= joined %> / <%= required %>
    </span>
  </div>

  <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
    <div class="bg-blue-500 h-3 rounded-full transition-all duration-700"
         style="width: <%= volunteerProgress %>%"></div>
  </div>

</div>

<!-- VOLUNTEERS LIST -->
<div class="bg-white p-6 rounded-xl shadow space-y-5">

  <h2 class="font-semibold text-gray-800 flex items-center gap-2">
    <i class="fa-solid fa-user-group"></i>
    Volunteers
  </h2>

  <% if (!campaign.volunteers || campaign.volunteers.length === 0) { %>
    <p class="text-gray-500 text-sm">No volunteers yet</p>
  <% } else { %>

    <div class="space-y-3">

      <% campaign.volunteers.forEach(v => { %>

        <div class="flex justify-between bg-gray-50 p-3 rounded-lg">

          <span class="flex items-center gap-2 font-medium">
            <i class="fa-solid fa-user text-gray-400"></i>
            <%= v.name %>
          </span>

          <span class="text-sm text-gray-500 flex items-center gap-2">
            <i class="fa-solid fa-envelope"></i>
            <%= v.email %>
          </span>

        </div>

      <% }) %>

    </div>

  <% } %>

</div>

<!-- ACTIONS -->
<div class="flex gap-5 pt-2">

  <% if (user && user.role === 'donor') { %>

    <a href="/donor/donate/<%= campaign._id %>"
       class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl text-center font-semibold flex items-center justify-center gap-2">

      <i class="fa-solid fa-hand-holding-dollar"></i>
      Donate Now

    </a>

  <% } %>

  <% if (user && user.role === 'volunteer') { %>

    <form action="/volunteer/campaigns/<%= campaign._id %>/join"
          method="POST"
          class="flex-1">

      <button class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-xl font-semibold flex items-center justify-center gap-2">

        <i class="fa-solid fa-handshake"></i>
        Join Campaign

      </button>

    </form>

  <% } %>

</div>

</main>

<%- include('../partials/footer') %>

</body>
</html>