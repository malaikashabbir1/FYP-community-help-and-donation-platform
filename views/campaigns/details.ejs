<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campaign Details</title>

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    .progress-bar {
      width: 0%;
      transition: width 1.2s ease-in-out;
    }
  </style>
</head>

<body class="bg-gray-100 min-h-screen">

<%- include('../partials/navbar') %>

<%
  const goal = Number(campaign.goal) || 0;
  const raised = Number(campaign.raised) || 0;

  const donationProgress = goal > 0
    ? Math.min((raised / goal) * 100, 100)
    : 0;

  // ✅ FIX: use approved applications instead of campaign.volunteers
  const joined = volunteers?.length || 0;
  const required = Number(campaign.requiredVolunteers) || 0;

  const volunteerProgress = required > 0
    ? Math.min((joined / required) * 100, 100)
    : 0;

  const remaining = Math.max(0, goal - raised);
%>

<main class="max-w-4xl mx-auto px-4 py-10 space-y-8">

<!-- HEADER -->
<div class="bg-white rounded-xl shadow p-6 space-y-6">

  <div class="flex gap-5 items-start">

    <div class="w-24 h-24 bg-gray-200 rounded-lg overflow-hidden flex-shrink-0">
      <% if (campaign.image) { %>
        <img src="<%= campaign.image %>" class="w-full h-full object-cover">
      <% } %>
    </div>

    <div class="flex-1 space-y-3">

      <h1 class="text-2xl font-bold text-gray-800"><%= campaign.name %></h1>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-solid fa-user"></i>
        <%= campaign.createdBy?.name %>
      </p>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-solid fa-location-dot"></i>
        <%= campaign.location || 'Not specified' %>
      </p>

      <p class="text-sm text-gray-600 flex items-center gap-2">
        <i class="fa-regular fa-calendar"></i>
        Created: <%= new Date(campaign.createdAt).toDateString() %>
      </p>

    </div>

  </div>
</div>

<!-- DESCRIPTION -->
<div class="bg-white rounded-xl shadow p-6">
  <h2 class="text-sm font-semibold text-gray-500 mb-2">
    <i class="fa-solid fa-align-left"></i> Description
  </h2>

  <p class="text-gray-700 text-sm leading-relaxed">
    <%= campaign.description %>
  </p>
</div>

<!-- STATS -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

  <div class="bg-white p-5 rounded-xl shadow">
    <p class="text-gray-500 text-sm">Goal</p>
    <p class="font-bold text-lg">Rs <%= goal %></p>
  </div>

  <div class="bg-white p-5 rounded-xl shadow">
    <p class="text-gray-500 text-sm">Raised</p>
    <p class="font-bold text-lg">Rs <%= raised %></p>
  </div>

  <div class="bg-white p-5 rounded-xl shadow">
    <p class="text-gray-500 text-sm">Remaining</p>
    <p class="font-bold text-lg">Rs <%= remaining %></p>
  </div>

</div>

<!-- DONATION PROGRESS -->
<div class="bg-white p-6 rounded-xl shadow space-y-4">

  <div class="flex justify-between text-sm text-gray-600">
    <span>Donation Progress</span>
    <span><%= donationProgress.toFixed(0) %>%</span>
  </div>

  <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
    <div class="bg-green-500 h-3 progress-bar"
         data-progress="<%= donationProgress %>"></div>
  </div>

</div>

<!-- VOLUNTEER PROGRESS -->
<div class="bg-white p-6 rounded-xl shadow space-y-4">

  <div class="flex justify-between text-sm text-gray-600">
    <span>Volunteer Progress</span>
    <span><%= joined %> / <%= required %></span>
  </div>

  <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
    <div class="bg-blue-500 h-3 progress-bar"
         data-progress="<%= volunteerProgress %>"></div>
  </div>

</div>

<!-- VOLUNTEERS -->
<div class="bg-white p-6 rounded-xl shadow space-y-3">

  <h2 class="font-semibold text-gray-800">
    <i class="fa-solid fa-users"></i> Volunteers
  </h2>

  <% if (!volunteers || volunteers.length === 0) { %>
    <p class="text-gray-500 text-sm">No volunteers yet</p>
  <% } else { %>

    <% volunteers.forEach(v => { %>
      <div class="flex justify-between bg-gray-50 p-3 rounded-lg">
        <span><%= v.user.name %></span>
        <span class="text-sm text-gray-500"><%= v.user.email %></span>
      </div>
    <% }) %>

  <% } %>

</div>

<!-- ACTIONS -->
<div class="flex gap-5 pt-2">

  <% if (user && user.role === 'donor') { %>
    <a href="/donor/donate/<%= campaign._id %>"
       class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl text-center font-semibold">
      <i class="fa-solid fa-hand-holding-dollar"></i> Donate Now
    </a>
  <% } %>

  <% if (user && user.role === 'volunteer') { %>

    <% if (!existingApplication) { %>

      <a href="/volunteer/campaigns/<%= campaign._id %>/join"
        class="flex-1 bg-green-600 hover:bg-green-700 text-white py-3 rounded-xl text-center font-semibold">
        <i class="fa-solid fa-handshake"></i> Join Campaign
      </a>

    <% } else { %>

      <div class="flex-1 bg-white border rounded-xl py-3 text-center font-semibold">
        <p class="text-sm text-gray-500">Application Status</p>

        <% if (existingApplication.status === 'approved') { %>
          <span class="text-green-600">Approved</span>
        <% } else if (existingApplication.status === 'rejected') { %>
          <span class="text-red-600">Rejected</span>
        <% } else { %>
          <span class="text-yellow-600">Pending</span>
        <% } %>

      </div>

    <% } %>

  <% } %>

</div>

</main>

<%- include('../partials/footer') %>

<script>
  document.querySelectorAll(".progress-bar").forEach(bar => {
    let value = parseFloat(bar.getAttribute("data-progress"));

    if (isNaN(value)) value = 0;
    if (value > 100) value = 100;

    setTimeout(() => {
      bar.style.width = value + "%";
    }, 150);
  });
</script>

</body>
</html>