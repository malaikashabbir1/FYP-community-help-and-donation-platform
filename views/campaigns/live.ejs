<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Campaigns</title>

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen">

<%- include('../partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 py-8">

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Live Campaigns</h1>
    <p class="text-gray-500">Explore ongoing campaigns and contribute</p>
  </div>

  <!-- GRID -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

    <% campaigns.forEach(c => { %>

      <div class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col h-full">

        <!-- IMAGE -->
        <div class="h-48 bg-gray-100">
          <% if (c.image) { %>
            <img src="<%= c.image %>" class="w-full h-full object-cover">
          <% } else { %>
            <div class="h-full flex items-center justify-center text-gray-400">
              No Image
            </div>
          <% } %>
        </div>

        <!-- BODY -->
        <div class="p-5 flex flex-col flex-1">

          <!-- TITLE -->
          <h2 class="text-lg font-bold text-gray-800 line-clamp-2 min-h-[48px]">
            <%= c.name %>
          </h2>

          <!-- DESCRIPTION -->
          <p class="text-sm text-gray-600 mt-2 line-clamp-2 min-h-[40px]">
            <%= c.description %>
          </p>

          <!-- QUICK INFO -->
          <div class="mt-3 text-sm text-gray-600 space-y-1">
            <p><i class="fas fa-bullseye text-blue-500"></i> Goal: Rs <%= c.goal %></p>
            <p><i class="fas fa-hand-holding-dollar text-green-500"></i> Raised: Rs <%= c.raised %></p>
            <p><i class="fas fa-users text-purple-500"></i> Volunteers: <%= c.volunteers?.length || 0 %> / <%= c.requiredVolunteers || 0 %></p>
          </div>

          <!-- PUSH TO BOTTOM -->
          <div class="flex-1"></div>

          <!-- STATUS -->
          <div class="mt-3">
            <% if (c.status === 'active') { %>
              <span class="bg-green-100 text-green-700 px-2 py-1 text-xs rounded">
                <i class="fas fa-circle text-green-500"></i> Live
              </span>
            <% } else { %>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 text-xs rounded">
                <i class="fas fa-flag-checkered text-blue-500"></i> Completed
              </span>
            <% } %>
          </div>

          <!-- ACTIONS -->
          <div class="mt-6 space-y-3 pt-4">

            <a href="/campaigns/<%= c._id %>"
               class="w-full block text-center bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 rounded-lg font-medium">
              <i class="fas fa-eye"></i> View Details
            </a>

            <% if (user && user.role === 'donor') { %>
              <a href="/donor/donate/<%= c._id %>"
                 class="w-full block text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold">
                <i class="fas fa-heart"></i> Donate Now
              </a>
            <% } %>

            <% if (user && user.role === 'volunteer') { %>
              <form action="/volunteer/campaigns/<%= c._id %>/join" method="POST">
                <button class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-semibold">
                  <i class="fas fa-user-plus"></i> Join Field Work
                </button>
              </form>
            <% } %>

          </div>

        </div>
      </div>

    <% }) %>

  </div>

</main>

<%- include('../partials/footer') %>

</body>
</html>