<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Campaigns</title>
  <link rel="icon" type="image/png" href="/images/logo.PNG">

  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="bg-gray-100 min-h-screen">

<%- include('../partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 py-8">

  <!-- HEADER -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Live Campaigns</h1>
    <p class="text-gray-500">Explore ongoing campaigns and contribute</p>
  </div>

  <!-- FLASH -->
  <% if (message) { %>
    <div id="alertBox"
      class="mb-6 px-4 py-3 rounded-lg shadow flex justify-between items-center
      <%= message.type === 'success'
        ? 'bg-green-100 text-green-700 border border-green-300'
        : 'bg-red-100 text-red-700 border border-red-300' %>">

      <span class="text-sm font-medium"><%= message.text %></span>

      <button onclick="document.getElementById('alertBox').remove()"
        class="text-lg font-bold px-2">&times;</button>

    </div>
  <% } %>

  <!-- RECOMMENDED -->
  <% if (recommended && recommended.length > 0) { %>

  <div class="mb-10">

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-green-700 flex items-center gap-2">
        <i class="fas fa-star text-green-600"></i>
        Recommended for You
      </h2>

      <span class="text-xs bg-green-100 text-green-700 px-3 py-1 rounded-full">
        Personalized
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

      <% recommended.forEach(c => { %>

        <div class="bg-white border border-green-200 rounded-xl p-5 shadow-sm hover:shadow-md transition">

          <div class="flex items-start justify-between">
            <h3 class="font-bold text-gray-800 line-clamp-1 pr-2">
              <%= c.name %>
            </h3>

            <i class="fas fa-thumbs-up text-green-500"></i>
          </div>

          <p class="text-sm text-gray-600 line-clamp-2 mt-2">
            <%= c.description %>
          </p>

          <% if (c.category) { %>
            <p class="text-xs text-green-600 mt-3 flex items-center gap-1">
              <i class="fas fa-tag"></i>
              <%= c.category %>
            </p>
          <% } %>

          <a href="/campaigns/<%= c._id %>"
             class="mt-4 inline-block w-full text-center bg-green-600 hover:bg-green-700 text-white py-2 rounded-lg font-medium">
            <i class="fas fa-eye mr-1"></i> View Campaign
          </a>

        </div>

      <% }) %>

    </div>
  </div>

  <% } %>

  <!-- TRENDING -->
  <% if (trending && trending.length > 0) { %>

  <div class="mb-10">

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
        <i class="fas fa-chart-line text-orange-500"></i>
        Trending Campaigns
      </h2>

      <span class="text-xs bg-orange-100 text-orange-600 px-3 py-1 rounded-full">
        Hot Right Now
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

      <% trending.forEach(c => { %>

        <div class="bg-white border border-orange-200 rounded-xl p-5 shadow-sm hover:shadow-md transition relative">

          <span class="absolute top-3 right-3 text-xs bg-orange-100 text-orange-600 px-2 py-1 rounded-full flex items-center gap-1">
            <i class="fas fa-fire"></i>
            Trending
          </span>

          <h3 class="font-bold text-gray-800 line-clamp-1 pr-6">
            <%= c.name %>
          </h3>

          <p class="text-sm text-gray-600 line-clamp-2 mt-2">
            <%= c.description %>
          </p>

          <a href="/campaigns/<%= c._id %>"
             class="mt-4 inline-block w-full text-center bg-orange-600 hover:bg-orange-700 text-white py-2 rounded-lg font-medium">
            <i class="fas fa-arrow-right mr-1"></i> Explore
          </a>

        </div>

      <% }) %>

    </div>
  </div>

  <% } %>

  <!-- MAIN GRID (UNCHANGED) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

    <% campaigns.forEach(c => { %>

      <%
        const campaignId = c._id.toString();

        const approvedCount =
          (typeof approvedCountMap !== 'undefined' &&
           approvedCountMap[campaignId])
            ? approvedCountMap[campaignId]
            : 0;

        const required = c.requiredVolunteers || 0;
        const isFull = approvedCount >= required;

        const app = applicationMap?.[campaignId];
      %>

      <div class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col h-full">

        <div class="h-48 bg-gray-100">
          <% if (c.image) { %>
            <img src="<%= c.image %>" class="w-full h-full object-cover">
          <% } else { %>
            <div class="h-full flex items-center justify-center text-gray-400">
              No Image
            </div>
          <% } %>
        </div>

        <div class="p-5 flex flex-col flex-1">

          <h2 class="text-lg font-bold text-gray-800 line-clamp-2 min-h-[48px]">
            <%= c.name %>
          </h2>

          <p class="text-sm text-gray-600 mt-2 line-clamp-2 min-h-[40px]">
            <%= c.description %>
          </p>

          <% if (c.category) { %>
            <p class="text-xs text-gray-500 mt-2">
              <i class="fas fa-tag text-indigo-500"></i>
              Category:
              <%= c.category
                .replaceAll('_',' ')
                .replace(/\b\w/g, l => l.toUpperCase()) %>
            </p>
          <% } %>

          <div class="mt-3 text-sm text-gray-600 space-y-1">

            <p>
              <i class="fas fa-bullseye text-blue-500"></i>
              Goal: Rs <%= c.goal %>
            </p>

            <p>
              <i class="fas fa-hand-holding-dollar text-green-500"></i>
              Raised: Rs <%= c.raised %>
            </p>

            <p>
              <i class="fas fa-users text-purple-500"></i>
              Volunteers: <%= approvedCount %> / <%= required %>
            </p>

          </div>

          <div class="flex-1"></div>

          <div class="mt-3">

            <% if (c.status === 'active') { %>

              <% if (isFull) { %>
                <span class="bg-red-100 text-red-700 px-2 py-1 text-xs rounded">
                  <i class="fas fa-lock text-red-500"></i> Full
                </span>
              <% } else { %>
                <span class="bg-green-100 text-green-700 px-2 py-1 text-xs rounded">
                  <i class="fas fa-circle text-green-500"></i> Live
                </span>
              <% } %>

            <% } else { %>
              <span class="bg-blue-100 text-blue-700 px-2 py-1 text-xs rounded">
                <i class="fas fa-flag-checkered text-blue-500"></i> Completed
              </span>
            <% } %>

          </div>

          <div class="mt-6 space-y-3 pt-4">

            <a href="/campaigns/<%= c._id %>"
               class="w-full block text-center bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 rounded-lg font-medium">
              <i class="fas fa-eye"></i> View Details
            </a>

            <% if (user && user.role === 'donor') { %>
              <a href="/donor/donate/<%= c._id %>"
                 class="w-full block text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold">
                <i class="fas fa-heart"></i> Donate Now
              </a>
            <% } %>

            <% if (user && user.role === 'volunteer') { %>

              <% if (app) { %>

                <div class="w-full bg-white border rounded-lg py-3 text-center font-semibold space-y-1">

                  <% if (app.status === 'approved') { %>
                    <span class="text-green-600">🟢 Approved</span>
                  <% } else if (app.status === 'rejected') { %>
                    <span class="text-red-600">🔴 Rejected</span>
                  <% } else { %>
                    <span class="text-yellow-600">🟡 Pending</span>
                  <% } %>

                  <p class="text-xs text-gray-500 mt-1">
                    Applied: <%= new Date(app.createdAt).toDateString() %>
                  </p>

                </div>

              <% } else { %>

                <% if (isFull) { %>

                  <div class="w-full text-center bg-red-100 text-red-700 py-3 rounded-lg font-semibold">
                    <i class="fas fa-ban"></i> No more volunteers required
                  </div>

                <% } else { %>

                  <a href="/volunteer/campaigns/<%= c._id %>/join"
                    class="w-full block text-center bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-semibold">
                    <i class="fas fa-user-plus"></i> Join Field Work
                  </a>

                <% } %>

              <% } %>

            <% } %>

          </div>

        </div>
      </div>

    <% }) %>

  </div>

</main>

<%- include('../partials/footer') %>

<script>
  setTimeout(() => {
    const alertBox = document.getElementById('alertBox');
    if (alertBox) {
      alertBox.style.opacity = "0";
      setTimeout(() => alertBox.remove(), 500);
    }
  }, 3000);
</script>

</body>
</html>